{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_false": {
      "type": "minecraft:model",
      "model": "vanilla_bow_tiers:item/iron_bow"
    },
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "firstperson_righthand",
            "thirdperson_righthand",
            "gui",
            "head",
            "ground",
            "fixed"
          ],
          "model": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:use_duration",
            "scale": 0.05,
            "entries": [
              {
                "threshold": 0.65,
                "model": {
                  "type": "minecraft:composite",
                  "models": [
                    {
                      "type": "minecraft:model",
                      "model": "vanilla_bow_tiers:item/bray/iron_bow_pulling_1"
                    },
                    {
                      "type": "minecraft:model",
                      "model": "vanilla_bow_tiers:item/bray/iron_arrow_pulling_1_right"
                    }
                  ]
                }
              },
              {
                "threshold": 0.9,
                "model": {
                  "type": "minecraft:composite",
                  "models": [
                    {
                      "type": "minecraft:model",
                      "model": "vanilla_bow_tiers:item/bray/iron_bow_pulling_2"
                    },
                    {
                      "type": "minecraft:condition",
                      "property": "minecraft:component",
                      "predicate": "minecraft:enchantments",
                      "value": [
                        {
                          "enchantments": "minecraft:flame"
                        }
                      ],
                      "on_true": {
                        "type": "minecraft:model",
                        "model": "vanilla_bow_tiers:item/bray/iron_arrow_flame_pulling_2_right"
                      },
                      "on_false": {
                        "type": "minecraft:model",
                        "model": "vanilla_bow_tiers:item/bray/iron_arrow_pulling_2_right"
                      }
                    }
                  ]
                }
              }
            ],
            "fallback": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "vanilla_bow_tiers:item/bray/iron_bow_pulling_0"
                },
                {
                  "type": "minecraft:model",
                  "model": "vanilla_bow_tiers:item/bray/iron_arrow_pulling_0_right"
                }
              ]
            }
          }
        },
        {
          "when": [
            "firstperson_lefthand",
            "thirdperson_lefthand"
          ],
          "model": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:use_duration",
            "scale": 0.05,
            "entries": [
              {
                "threshold": 0.65,
                "model": {
                  "type": "minecraft:composite",
                  "models": [
                    {
                      "type": "minecraft:model",
                      "model": "vanilla_bow_tiers:item/bray/iron_bow_pulling_1"
                    },
                    {
                      "type": "minecraft:model",
                      "model": "vanilla_bow_tiers:item/bray/iron_arrow_pulling_1_left"
                    }
                  ]
                }
              },
              {
                "threshold": 0.9,
                "model": {
                  "type": "minecraft:composite",
                  "models": [
                    {
                      "type": "minecraft:model",
                      "model": "vanilla_bow_tiers:item/bray/iron_bow_pulling_2"
                    },
                    {
                      "type": "minecraft:condition",
                      "property": "minecraft:component",
                      "predicate": "minecraft:enchantments",
                      "value": [
                        {
                          "enchantments": "minecraft:flame"
                        }
                      ],
                      "on_true": {
                        "type": "minecraft:model",
                        "model": "vanilla_bow_tiers:item/bray/iron_arrow_flame_pulling_2_left"
                      },
                      "on_false": {
                        "type": "minecraft:model",
                        "model": "vanilla_bow_tiers:item/bray/iron_arrow_pulling_2_left"
                      }
                    }
                  ]
                }
              }
            ],
            "fallback": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "vanilla_bow_tiers:item/bray/iron_bow_pulling_0"
                },
                {
                  "type": "minecraft:model",
                  "model": "vanilla_bow_tiers:item/bray/iron_arrow_pulling_0_left"
                }
              ]
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "vanilla_bow_tiers:item/iron_bow"
      }
    }
  }
}
